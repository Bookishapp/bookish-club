# Set these through the deployment secret store. Do not commit real values.
SUPABASE_URL=https://tkrsrnlasinmlftkcufi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Platform-injected legacy public anon key. Do not override it with service credentials.
# Client builds use the dedicated project publishable key by default.
SUPABASE_ANON_KEY=
# Bookish sender only. Website mail is separate from dedicated-project Auth SMTP.
BOOKISH_EMAIL_FROM=
RESEND_API_KEY=
BOOKISH_SITE_URL=https://meetbookish.com
# Native bundle ID; final value must match the iOS target and Apple registration.
BOOKISH_APPLE_CLIENT_ID=
BOOKISH_APPLE_TEAM_ID=
BOOKISH_APPLE_KEY_ID=
BOOKISH_APPLE_PRIVATE_KEY=
# Supabase Apple provider secret, when using the config fragment (separate from .p8).
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Published, reachable policies and a monitored moderation inbox.
BOOKISH_TERMS_URL=
BOOKISH_PRIVACY_URL=
BOOKISH_MODERATION_EMAIL=
