<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.meetbookish.report-alerts</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON3__</string>
		<string>__TED_OPS_DIR__/bookish-report-alerts/bookish_report_alerts.py</string>
	</array>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>__TED_OPS_DIR__</string>
	<key>StandardOutPath</key>
	<string>__TED_OPS_DIR__/logs/bookish-report-alerts.log</string>
	<key>StandardErrorPath</key>
	<string>__TED_OPS_DIR__/logs/bookish-report-alerts.error.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
