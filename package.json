{
  "name": "bookish-club",
  "private": true,
  "type": "module",
  "scripts": {
    "test:confirmation": "node --test tests/confirmation/*.test.mjs",
    "ref": "node scripts/build-ref.mjs",
    "merge": "node scripts/merge.mjs",
    "build": "node scripts/build.mjs",
    "seed": "node scripts/sources/library-other.mjs; node scripts/sources/bookstores.mjs; node scripts/merge.mjs",
    "build:web": "npm run build && node scripts/build-web.mjs",
    "test:web": "node --test scripts/test-site.mjs scripts/test-lunair.mjs scripts/test-web.mjs",
    "test": "node --test tests/backend/*.test.mjs",
    "check:edge": "deno check --no-config supabase/functions/bookish-delete-account/index.ts supabase/functions/bookish-house-rules/index.ts",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "test:visibility": "node --experimental-vm-modules --test tests/visibility/*.test.mjs",
    "test:server": "node --test tests/visibility/database.test.mjs tests/visibility/http.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10"
  },
  "engines": {
    "node": ">=24"
  }
}
